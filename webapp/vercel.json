{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/:path*", "destination": "/api/:path*" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    },
    "api/[...path].ts": {
      "includeFiles": "dist/**"
    }
  }
}
